[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_screen.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/Board.tscn" id="2_board"]
[ext_resource type="Script" path="res://scripts/ui/cat_mascot.gd" id="3_mascot"]
[ext_resource type="Script" path="res://scripts/ui/lives_display.gd" id="4_lives"]
[ext_resource type="Script" path="res://scripts/ui/square_slot.gd" id="5_slot"]

[node name="GameScreen" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_game")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

; alignment = 1 centres the whole stack, so the board sits in the middle of the
; screen with its header packed directly above and the cat count directly below.
[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="HeaderRow" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TierLabel" type="Label" parent="Margin/Layout/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.298, 0.231, 0.192, 1)
theme_override_font_sizes/font_size = 26
text = "Level 1"
vertical_alignment = 1

[node name="Lives" type="Control" parent="Margin/Layout/HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 32)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("4_lives")

[node name="TimeLabel" type="Label" parent="Margin/Layout/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.545, 0.467, 0.404, 1)
theme_override_font_sizes/font_size = 26
text = "0:00"
vertical_alignment = 1

[node name="BoardWrap" type="AspectRatioContainer" parent="Margin/Layout"]
layout_mode = 2
ratio = 1.0
stretch_mode = 2
script = ExtResource("5_slot")

[node name="Board" parent="Margin/Layout/BoardWrap" instance=ExtResource("2_board")]
unique_name_in_owner = true
layout_mode = 2

[node name="ProgressLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.545, 0.467, 0.404, 1)
theme_override_font_sizes/font_size = 26
text = "0 / 5 cats"
horizontal_alignment = 1



; Pinned to the bottom edge rather than stacked with the board. Controls belong
; where the thumb rests, and leaving them in the centred group pushed the board
; visibly above centre.
[node name="BottomBar" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 14.0
offset_top = -116.0
offset_right = -14.0
offset_bottom = -14.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 8

[node name="StatusLabel" type="Label" parent="BottomBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_colors/font_color = Color(0.831, 0.439, 0.235, 1)
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
autowrap_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="BottomBar"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="UndoButton" type="Button" parent="BottomBar/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Undo"

[node name="RedoButton" type="Button" parent="BottomBar/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Redo"

[node name="ClearButton" type="Button" parent="BottomBar/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Clear"

[node name="HintButton" type="Button" parent="BottomBar/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Hint"

; Anchored rather than stacked: a way out belongs at the top of the screen, not
; travelling up and down with the centred play area.
[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 0
offset_left = 14.0
offset_top = 14.0
offset_right = 138.0
offset_bottom = 80.0
theme_override_font_sizes/font_size = 24
text = "Menu"

[node name="LoadingPanel" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.969, 0.937, 0.89, 0.94)

[node name="Center" type="CenterContainer" parent="LoadingPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="LoadingLabel" type="Label" parent="LoadingPanel/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.298, 0.231, 0.192, 1)
theme_override_font_sizes/font_size = 26
text = "Setting up..."
horizontal_alignment = 1

[node name="ResultPanel" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.969, 0.937, 0.89, 0.55)

[node name="Center" type="CenterContainer" parent="ResultPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="ResultPanel/Center"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="ResultPanel/Center/Card"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="ResultCat" type="Control" parent="ResultPanel/Center/Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_mascot")

[node name="ResultTitle" type="Label" parent="ResultPanel/Center/Card/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.298, 0.231, 0.192, 1)
theme_override_font_sizes/font_size = 40
text = "Level done"
horizontal_alignment = 1

[node name="ResultDetail" type="Label" parent="ResultPanel/Center/Card/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.545, 0.467, 0.404, 1)
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1
autowrap_mode = 2

[node name="AgainButton" type="Button" parent="ResultPanel/Center/Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 70)
theme_override_font_sizes/font_size = 26
layout_mode = 2
text = "Next level"

[node name="ResultMenuButton" type="Button" parent="ResultPanel/Center/Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 70)
theme_override_font_sizes/font_size = 26
layout_mode = 2
text = "Menu"
